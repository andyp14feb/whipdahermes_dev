API_URL=http://localhost:8000
MACHINE_ID=
INTERVAL=5
COMMAND_POLL_INTERVAL=5
STALE_TIMEOUT_SECONDS=60
CLEANUP_TIMEOUT_SECONDS=86400

# API server
API_HOST=0.0.0.0
API_PORT=8000

# Dashboard server (used by docker-compose and vite dev server)
DASHBOARD_PORT=3000
PORT=3000

# Machine agent
STATE_DIR=~/.local/state/whipai

# Live web terminal (P0 spike) — shared token for browser + agent WS
# Leave empty to allow unauthenticated WS (dev only). Prefer setting a token.
WHIPAI_TERMINAL_TOKEN=dev-terminal-token
# Optional dashboard override (otherwise vite proxies /ws to API)
# VITE_WHIPAI_TERMINAL_TOKEN=dev-terminal-token
# VITE_API_BASE_URL=
